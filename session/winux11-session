#!/bin/sh
set -eu
prefix="${WINUX11_PREFIX:-/usr}"
export XDG_CURRENT_DESKTOP=WINUX11
export XDG_SESSION_DESKTOP=WINUX11
export XDG_SESSION_TYPE=wayland
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-winux11}"
[ -d "$XDG_RUNTIME_DIR" ] || { echo "WINUX11: XDG_RUNTIME_DIR is unavailable" >&2; exit 1; }
compositor="$prefix/bin/winux11-compositor"
shell="$prefix/bin/winux11-shell"
[ -x "$compositor" ] && [ -x "$shell" ] || { echo "WINUX11: compositor or shell is not installed" >&2; exit 1; }
compositor_qpa="${WINUX11_COMPOSITOR_QPA_PLATFORM:-wayland}"
if [ -n "${WINUX11_COMPOSITOR_QT_QUICK_BACKEND:-}" ]; then
  QT_QPA_PLATFORM="$compositor_qpa" QT_QUICK_BACKEND="$WINUX11_COMPOSITOR_QT_QUICK_BACKEND" "$compositor" --wayland-socket-name="$WAYLAND_DISPLAY" &
else
  QT_QPA_PLATFORM="$compositor_qpa" "$compositor" --wayland-socket-name="$WAYLAND_DISPLAY" &
fi
compositor_pid=$!
cleanup(){ kill "$compositor_pid" 2>/dev/null || true; wait "$compositor_pid" 2>/dev/null || true; }
trap cleanup INT TERM EXIT
for i in $(seq 1 100); do
  [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
  kill -0 "$compositor_pid" 2>/dev/null || exit 1
  sleep .05
done
[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || { echo "WINUX11: compositor Wayland socket did not become ready" >&2; exit 1; }
if [ "${WINUX11_HEADLESS_SMOKE:-0}" = "1" ]; then
  wait "$compositor_pid"
  exit 0
fi
export QT_QPA_PLATFORM=wayland
exec "$shell"
